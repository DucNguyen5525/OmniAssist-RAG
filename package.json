{
  "name": "helpdesk-pageindex-rag",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @helpdesk/web",
    "build": "npm run build --workspace @helpdesk/shared && npm run build --workspace @helpdesk/web",
    "lint": "npm run lint --workspace @helpdesk/shared && npm run lint --workspace @helpdesk/web",
    "typecheck": "npm run typecheck --workspace @helpdesk/shared && npm run typecheck --workspace @helpdesk/web",
    "import:pageindex": "tsx scripts/import-pageindex.ts",
    "import:dataset": "tsx scripts/import-dataset.ts",
    "eval:pageindex": "tsx scripts/eval-pageindex-retrieval.ts",
    "eval:ragas": "node scripts/run-python.mjs --venv .venv-ragas scripts/eval-ragas-answer-quality.py",
    "smoke:pageindex-ingestion": "node scripts/run-python.mjs --venv .venv-pageindex workers/pageindex-ingest/smoke_ingestion_e2e.py",
    "migrate:pageindex-legacy": "node scripts/run-python.mjs --venv .venv-pageindex workers/pageindex-ingest/migrate_legacy_pageindex.py",
    "spike:pageindex": "tsx scripts/spike-pageindex-architecture.ts",
    "test:pageindex": "tsx --test apps/web/lib/server/gemini.test.ts apps/web/lib/server/helpdesk-sync.test.ts apps/web/lib/server/pageindex-artifact.test.ts apps/web/lib/server/pageindex-flatten.test.ts apps/web/lib/server/pageindex-tree.test.ts apps/web/lib/server/pageindex-reasoning.test.ts apps/web/lib/server/retrieval.test.ts",
    "test:pageindex-python": "node scripts/run-python.mjs -m unittest discover -s workers/pageindex-ingest -p \"test_*.py\"",
    "test:ragas-python": "node scripts/run-python.mjs --venv .venv-ragas -m unittest discover -s evals/ragas -p \"test_*.py\"",
    "train:shock": "tsx scripts/train-shock-model.ts"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
